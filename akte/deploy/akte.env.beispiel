# /etc/akte.env  (chmod 600)  -  Werte eintragen, dann: systemctl restart akte
AKTE_PORT=8410
AKTE_BASIS_URL=https://akte.reika.live
AKTE_GEHEIMNIS=ERSETZEN-langer-zufallswert
AKTE_DATEN=/opt/akte/daten
DATABASE_URL=postgresql+psycopg2://akte:PASSWORT@127.0.0.1:5432/akte

# Erster Berater (nur beim allerersten Start, wenn die Tabelle leer ist)
AKTE_BERATER_NAME=Tobi Dolgener
AKTE_BERATER_EMAIL=tobias@pathfinders.berlin
AKTE_BERATER_PASSWORT=ERSETZEN

# Mail (ohne SMTP_HOST landen Mails als .eml unter AKTE_DATEN/ausgang)
AKTE_SMTP_HOST=
AKTE_SMTP_PORT=587
AKTE_SMTP_USER=
AKTE_SMTP_PASSWORT=
AKTE_ABSENDER=sales@tobidolgener.com

# Web Push: python push.py schluessel
AKTE_VAPID_PRIVAT=
AKTE_VAPID_OEFFENTLICH=
AKTE_VAPID_KONTAKT=mailto:tobias@pathfinders.berlin

# KI (ohne Schluessel: Heuristik + manuelle Pruefung durch den Berater)
ANTHROPIC_API_KEY=
AKTE_KI_MODELL=claude-opus-5-5

# Homepage-Buchung: geteiltes Geheimnis fuer POST /api/buchung
AKTE_BUCHUNG_SCHLUESSEL=

# Scanner-Schwellen (mit echten Fotos nachjustieren)
AKTE_SCAN_MIN_SCHAERFE=60
AKTE_SCAN_MIN_HELLIGKEIT=70
AKTE_SCAN_MAX_HELLIGKEIT=235
AKTE_NACHFRAGE_MAKLER_TAGE=2
