[Unit]
Description=AKTE Unterlagen-App
After=network.target postgresql.service

[Service]
User=akte
Group=akte
WorkingDirectory=/opt/akte/backend
EnvironmentFile=/etc/akte.env
ExecStart=/opt/akte/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port ${AKTE_PORT} --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
